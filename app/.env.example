# ── Realtime interviewer (OpenAI Realtime API for now; Gemini Live later) ──
# With the Cornell LiteLLM gateway: set OPENAI_API_KEY to your LiteLLM key and:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.ai.it.cornell.edu
# For direct OpenAI instead, remove OPENAI_BASE_URL (defaults to api.openai.com).
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin

# ── LLM judge for the post-interview report ──
ANTHROPIC_API_KEY=

# ── Supabase (sessions, transcripts, reports, audio storage) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
