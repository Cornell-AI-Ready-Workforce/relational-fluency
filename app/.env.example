# ── Cornell LiteLLM gateway (serves both the realtime interviewer and the judge) ──
OPENAI_API_KEY=            # your Cornell LiteLLM key
OPENAI_BASE_URL=https://api.ai.it.cornell.edu
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
LITELLM_JUDGE_MODEL=nto.gemini-2.5-flash

# ── AWS (study data in S3; one aligned record per encounter) ──
# Credentials come from the AWS default chain: locally your CLI profile,
# on ECS/Fargate the task role. Do NOT put access keys here.
AWS_REGION=us-east-1
S3_BUCKET=rf-study-data-540586745717
