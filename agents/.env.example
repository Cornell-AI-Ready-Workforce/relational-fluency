# --- LLM access ---
# Cornell LiteLLM proxy: set BOTH of these. The Anthropic SDK reads them from env.
#   ANTHROPIC_API_KEY  = your LiteLLM virtual key (sk-...)
#   ANTHROPIC_BASE_URL = the proxy base URL (ask the proxy admin; the proxy must
#                        expose the Anthropic /v1/messages-compatible endpoint)
# Direct Anthropic instead: set only ANTHROPIC_API_KEY, leave BASE_URL unset.
ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=

# Model names: with LiteLLM these must be the proxy's configured model aliases
# (ask the admin / check the proxy's /v1/models). Pin snapshots per study wave.
# Actor: pilot Fable 5 vs Opus 5 head-to-head, then pin the winner's snapshot.
# Director: Gemini Flash (decision 2026-08-03); reasoning off; alias per proxy.
ACTOR_MODEL=claude-sonnet-4-5
DIRECTOR_MODEL=gemini-3.6-flash

# --- Server ---
SCENARIO_ID=S2A
# When set, /v1/chat/completions requires "Authorization: Bearer <this value>".
# Use the same value as the API key in ElevenLabs custom-LLM settings.
AGENT_API_KEY=
STEERING_LOG_DIR=logs
